{
  "name": "lexbell-website",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Sitio oficial de Lexbell — Gestor de expedientes legales para Mac y Windows",
  "scripts": {
    "dev": "nuxt dev",
    "clean": "rm -rf _nuxt .output .nuxt",
    "build": "nuxt generate && rm -rf _nuxt && cp -R .output/public/* .",
    "generate": "npm run build",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@nuxtjs/i18n": "^9.5.4",
    "@nuxtjs/tailwindcss": "^6.12.2",
    "nuxt": "^3.15.4",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  }
}
