# Configuración de Analítica y Publicidad para Lexbell Website
#
# Para Google Ads / Google Analytics 4 (GA4):
# Pega tu ID de medición o conversión (ej. G-XXXXXXXXXX o AW-XXXXXXXXXX)
NUXT_PUBLIC_GOOGLE_TAG_ID=

# Para Meta Pixel (Facebook & Instagram Ads):
# Pega tu ID de Pixel numérico de Meta Business Manager (ej. 1234567890123456)
NUXT_PUBLIC_META_PIXEL_ID=

# Enlaces a las tiendas oficiales (ya configurados por defecto):
NUXT_PUBLIC_APPLE_STORE_URL=https://apps.apple.com/do/app/lexbell-expedientes-legales/id6791787627?mt=12
NUXT_PUBLIC_MICROSOFT_STORE_URL=https://apps.microsoft.com/detail/9NLZXP46J9G2
